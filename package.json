{
  "name": "megahard-whiteboard",
  "version": "0.1.0",
  "description": "A local-first whiteboard. Your boards stay on your device, and you can share them live.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardzeyFTW/Megahard-Whiteboard.git"
  },
  "homepage": "https://ardzeyftw.github.io/Megahard-Whiteboard/",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "dev:server": "npm --prefix server run dev",
    "test:server": "npm --prefix server test"
  },
  "dependencies": {
    "fractional-indexing": "^4.0.0",
    "lib0": "^0.2.119",
    "perfect-freehand": "^1.2.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
