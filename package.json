{
  "name": "megahard-whiteboard",
  "version": "0.1.4",
  "description": "A local-first whiteboard. Your boards stay on your device, and you can share them live.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardzeyFTW/Megahard-Whiteboard.git"
  },
  "homepage": "https://ardzeyftw.github.io/Megahard-Whiteboard/",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "dev:server": "npm --prefix server run dev",
    "test:server": "npm --prefix server test",
    "electron:start": "electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder --win",
    "build:exe": "npm run electron:build",
    "release": "node scripts/release.cjs"
  },
  "build": {
    "appId": "com.megahard.whiteboard",
    "productName": "Megahard Whiteboard",
    "publish": {
      "provider": "github",
      "owner": "ardzeyFTW",
      "repo": "Megahard-Whiteboard"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Megahard Whiteboard",
      "artifactName": "Megahard-Whiteboard-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "fractional-indexing": "^4.0.0",
    "lib0": "^0.2.119",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
